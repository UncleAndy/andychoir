package ai:host;

interface types {
  record event {
    request-id: string, // Сквозной ID пользовательского запроса
    session-id: string, // Сквозной ID пользовательской сессии
    source: string,     // Отправитель (напр., "agent_manager")
    target: string,     // Получатель (напр., "tool:calculator" или "agent:coder")
    topic: string,
    payload: string,
  }

  // Полное описание инструмента, доступного агенту. Возвращается хостом
  // в get-session-tools (без отдельного discovery-цикла).
  record tool-definition {
    name: string,        // напр. "calculator" или "tool:calculator"
    description: string,
    parameters-json: string, // JSON-схема параметров (OpenAI function.parameters)
  }

  // ============================================================================
  // СЛОВАРЬ ТОПИКОВ (event.topic) — ЕДИНЫЙ ДЛЯ ВСЕХ ПЛАГИНОВ И ХОСТА
  // ============================================================================
  // Канонические значения topic (история: ранее в README было "call"/"response"/
  // "info"/"error", в коде сложилось иное — зафиксировано ниже, старые не удаляем):
  //
  //   discovery  : agent -> tool        | запрос описания инструмента (ToolDefinition)
  //   definition : tool  -> agent       | ответ инструмента: его ToolDefinition (JSON)
  //   request    : любой -> любой       | запрос/вызов (пользователь->agent, agent->tool)
  //   response   : любой -> любой       | результат вызова (tool->agent, agent->пользователь)
  //   error      : любой -> любой       | ошибка выполнения вызова
  //   info       : любой -> любой       | служебное уведомление (логи/статус/системные)
  //   print      : agent -> front      | вывод текста в консоль (фронт-плагин печатает)
  //
  // Маски target (в диспетчере хоста):
  //   точное имя    : "front:console"        -> только этот плагин
  //   "*"           : все плагины
  //   префикс "*"   : "agent:*"              -> все плагины с классом "agent"
  // ============================================================================
}

interface event-bus {
  use types.{event};
  publish-event: func(ev: event);
}

interface console {
  print-line: func(line: string);
  // Напечатать Markdown с форматированием (терминал): хост рендерит через
  // termimad в ANSI (жирный/курсив/цвет/код-блоки).
  print-markdown: func(markdown: string);
  read-line: async func(prompt: string) -> option<string>;
}

interface log {
  debug: func(line: string);
  info: func(line: string);
  warn: func(line: string);
  error: func(line: string);
}

// HTTP-прокси: плагин НЕ имеет прямого сетевого доступа (песочница,
// fail-closed для сети). Все HTTP-запросы идут через хост, который
// выполняет реальный сетевой вызов и возвращает результат.
// Узкий контракт: плагин шлёт и получает готовый JSON (OpenAI-compatible LLM).
interface http {
  // Выполнить POST с JSON-телом. Возвращает HTTP-статус и тело ответа (как строку).
  post-json: async func(url: string, json-body: string) -> tuple<u16, string>;
}

// Управление хостом: блокирующие async-ожидания, которые отдают управление
// wasm-планировщику (чтобы handle_event мог выполняться во время ожидания).
interface host-control {
  use types.{event, tool-definition};

  // Ждать, пока хост не сообщит, что все плагины готовы (host:"ready").
  // Хост сигналит через Notify. Без блокировки wasm-нити (это async).
  wait-for-ready: async func();

  // Ждать, пока не придёт ответ (topic:"response") на запрос с данным
  // request-id. Хост держит карту request_id -> Notify и сигналит при
  // приходе response. Без блокировки wasm-нити (это async).
  wait-for-response: async func(request-id: string, session-id: string);

  // Ждать ответ с таймаутом (timeout-ms). Возвращает true, если ответ пришёл
  // до истечения, false — если таймаут. Предотвращает зависание, когда
  // инструмент не отвечает (ошибка/молчание).
  wait-for-response-timeout: async func(request-id: string, session-id: string, timeout-ms: u64) -> bool;

  // Забрать payload ответа на (request-id, session-id) (после wait-for-response-timeout).
  // Хост сохраняет payload последнего response по (session-id, request-id) при его приходе.
  // Возвращает None, если ответа нет. Нужно, т.к. wasmtime сериализует
  // handle_event: агент, ожидающий ответ, не может обработать входящий response
  // в своём же handle_event, поэтому payload хранится на хосте.
  // Доступно только для ЛОКАЛЬНОЙ сессии хоста (A2: защита от чтения чужих ответов).
  take-response-payload: async func(request-id: string, session-id: string) -> option<string>;

  // Вернуть историю диалоговых событий сессии (request/response),
  // сохранённую хостом. Пустой список, если сессии нет.
  get-session-history: async func(session-id: string) -> list<event>;

  // Очистить историю сессии (для команды /new).
  clear-session: async func(session-id: string);

  // Сгенерировать новый идентификатор сессии (хост централизованно).
  new-session-id: async func() -> string;

  // Вернуть текущий session-id для проекта: восстановленный из
  // ~/.andychour/current_session.json (если есть) либо новый.
  get-current-session-id: async func() -> string;

  // Вернуть полные определения инструментов, доступных агенту для ДАННОЙ
  // сессии: <инструменты сессии> + <локальные инструменты хоста>, после
  // фильтра белого списка агента. Приоритет у инструмента сессии.
  get-session-tools: async func(session-id: string) -> list<tool-definition>;

  // Вернуть JSON-конфиг ТЕКУЩЕГО плагина (тот же, что передаётся в init).
  // Нужен, чтобы конфиг был доступен и в фоновом инстансе (run), где init не
  // вызывается: static-данные былm-инстанса различаются между основным и
  // фоновым, а конфиг должен быть одинаковым. Хост хранит конфиг плагина.
  get-plugin-config: async func() -> string;

  // Прочитать файл. Доступны ТОЛЬКО пути под root права `filesystem`
  // (или из белого списка `read_file`). Path приводится к каноническому
  // абсолютному виду (защита от `..`). Лимит размера — как у console_print.
  read-file: async func(path: string) -> result<string, string>;

  // Записать файл (только при праве `filesystem` с rw). Path под root.
  write-file: async func(path: string, contents: string) -> result<_, string>;

  // Дописать в конец файла (append, требует rw).
  append-file: async func(path: string, contents: string) -> result<_, string>;

  // Удалить файл (требует rw).
  remove-file: async func(path: string) -> result<_, string>;

  // Создать каталог (рекурсивно, требует rw).
  make-dir: async func(path: string) -> result<_, string>;

  // Удалить каталог рекурсивно (требует rw).
  remove-dir: async func(path: string) -> result<_, string>;

  // Переименовать/переместить файл или каталог (требует rw).
  move-path: async func(src: string, dst: string) -> result<_, string>;

  // Скопировать файл (требует rw в целевом каталоге).
  copy-file: async func(src: string, dst: string) -> result<_, string>;

  // Список содержимого каталога (read-only, path под root).
  // Возвращает JSON-массив записей {name, path, kind: "file"|"dir", size}.
  list-dir: async func(path: string) -> result<string, string>;

  // Статус файла/каталога (read-only): JSON {kind, size, modified, is_file, is_dir}.
  stat-path: async func(path: string) -> result<string, string>;

  // Точечная правка файла: заменить `old` на `new` (требует rw). Ошибка, если
  // `old` не найден (fail-closed — не частичная перезапись).
  patch-file: async func(path: string, old: string, new: string) -> result<_, string>;

  // --- Генерация случайных данных (плагин random) ---
  // Возвращает случайное значение в текстовом виде (как просил пользователь:
  // только то, что можно представить строкой).
  // kind: "int" | "uint" | "float" | "bool" | "bytes" | "uuid" | "string" | "choice" | "shuffle"
  // params-json: JSON с параметрами:
  //   int/uint: {"min":N,"max":N}      float: {"min":N,"max":N}
  //   bool: {}
  //   bytes: {"size":N,"encoding":"hex"|"base64"|"base59"}
  //   uuid: {}
  //   string: {"length":N,"charset":"abc"}   (charset пустой = [a-zA-Z0-9])
  //   choice: {"items":["a","b"]}            shuffle: {"items":["a","b"]}
  random: async func(kind: string, params-json: string) -> result<string, string>;
}

// Регистрация HTTP-слушателей: http-фронт объявляет хосту, какие порты/URI
// слушать. Хост (axum-сервер) транслирует входящие HTTP-запросы в события
// шины с source="host:http", target="<имя плагина>:<port>:<uri>".
// Это позволяет нескольким http-фронтам сосуществовать: события разделяются
// по (порт, uri) в target.
interface http-server {
  record listener {
    port: u16,
    path: string,
    target: string,
    // Адрес привязки (B4). По умолчанию "0.0.0.0" (все интерфейсы).
    // Для локального доступа задайте "127.0.0.1".
    bind: option<string>,
    // Токен аутентификации (B4). Если задан, HTTP-запросы требуют
    // `Authorization: Bearer <token>`. None = без аутентификации (compat).
    auth-token: option<string>,
  }

  // Зарегистрировать HTTP-слушатель. Возвращает true при успехе.
  listen-http: async func(l: listener) -> bool;

  // Снять HTTP-слушатель (по порту и пути). Возвращает true при успехе.
  remove-listener: async func(port: u16, path: string) -> bool;

  // Вернуть список активных слушателей.
  get-listeners: async func() -> list<listener>;
}

// Регистрация WebSocket-слушателей: ws-фронт объявляет хосту, какие порты/URI
// слушать. Хост (axum WS-сервер) транслирует входящие WS-сообщения в события
// шины с source="host:ws", target="<имя плагина>:<port>:<uri>".
// Одно подключение может вести много сессий (session_id в каждом сообщении);
// ответы идут на сокет с пометкой session_id и request_id.
interface ws-server {
  record ws-listener {
    port: u16,
    path: string,
    target: string,
    // Адрес привязки (B4). По умолчанию "0.0.0.0". Для локального доступа — "127.0.0.1".
    bind: option<string>,
    // Токен аутентификации (B4). Если задан, WS-сообщения требуют поле
    // `auth: "<token>"` в JSON. None = без аутентификации (compat).
    auth-token: option<string>,
  }

  // Зарегистрировать WS-слушатель. Возвращает true при успехе.
  listen-ws: async func(l: ws-listener) -> bool;

  // Снять WS-слушатель (по порту и пути). Возвращает true при успехе.
  remove-listener: async func(port: u16, path: string) -> bool;

  // Вернуть список активных слушателей.
  get-listeners: async func() -> list<ws-listener>;
}

// Транспорт для MCP-клиента. Плагин mcp:client реализует ЛОГИКУ MCP
// (initialize, tools/list, tools/call, сессии, протокол JSON-RPC), а хост
// предоставляет только транспорт: спавнит stdio-подпроцесс сервера / держит
// HTTP-соединение, гоняет JSON-RPC строки. Плагин не имеет прямого сетевого
// доступа (песочница), поэтому транспорт — на стороне хоста.
interface mcp-transport {
  // Открыть stdio-подпроцесс MCP-сервера. Возвращает transport-id (или "-" при ошибке).
  // env — переменные окружения (пары ключ-значение), добавляются/переопределяют
  // окружение хоста при запуске подпроцесса.
  stdio-open: async func(command: string, args: list<string>, env: list<tuple<string, string>>) -> string;

  // Отправить JSON-RPC строку и дождаться ответа с совпадающим id.
  // Возвращает ответ (строка JSON-RPC) или none при таймауте/ошибке.
  // timeout-ms — максимальное время ожидания ответа.
  request: async func(transport-id: string, jsonrpc: string, timeout-ms: u64) -> option<string>;

  // Закрыть транспорт (убить подпроцесс/закрыть соединение).
  close: async func(transport-id: string);
}

interface plugin-lifecycle {
  use types.{event};

  init: async func(config-json: string) -> list<string>;
  run: async func(); // Если нужен параллельный цикл обработки для плагина.
  handle-event: async func(ev: event);
}

world host-plugin {
  import event-bus;
  import console;
  import log;
  import http;
  import host-control;
  import http-server;
  import ws-server;
  import mcp-transport;
  export plugin-lifecycle;
}
