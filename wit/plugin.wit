package ai:host;

interface types {
  record event {
    request-id: string, // Сквозной ID пользовательской сессии
    session-id: string, // Сквозной ID пользовательского запроса
    source: string,     // Отправитель (напр., "agent_manager")
    target: string,     // Получатель (напр., "tool:calculator" или "agent:coder")
    topic: string,
    payload: string,
  }

  // ============================================================================
  // СЛОВАРЬ ТОПИКОВ (event.topic) — ЕДИНЫЙ ДЛЯ ВСЕХ ПЛАГИНОВ И ХОСТА
  // ============================================================================
  // Канонические значения topic (история: ранее в README было "call"/"response"/
  // "info"/"error", в коде сложилось иное — зафиксировано ниже, старые не удаляем):
  //
  //   discovery  : agent -> tool        | запрос описания инструмента (ToolDefinition)
  //   definition : tool  -> agent       | ответ инструмента: его ToolDefinition (JSON)
  //   request    : любой -> любой       | запрос/вызов (пользователь->agent, agent->tool)
  //   response   : любой -> любой       | результат вызова (tool->agent, agent->пользователь)
  //   error      : любой -> любой       | ошибка выполнения вызова
  //   info       : любой -> любой       | служебное уведомление (логи/статус/системные)
  //   print      : agent -> front      | вывод текста в консоль (фронт-плагин печатает)
  //
  // Маски target (в диспетчере хоста):
  //   точное имя    : "front:console"        -> только этот плагин
  //   "*"           : все плагины
  //   префикс "*"   : "agent:*"              -> все плагины с классом "agent"
  // ============================================================================
}

interface event-bus {
  use types.{event};
  publish-event: func(ev: event);
}

interface console {
  print-line: func(line: string);
  read-line: async func(prompt: string) -> option<string>;
}

interface log {
  debug: func(line: string);
  info: func(line: string);
  warn: func(line: string);
  error: func(line: string);
}

// HTTP-прокси: плагин НЕ имеет прямого сетевого доступа (песочница,
// fail-closed для сети). Все HTTP-запросы идут через хост, который
// выполняет реальный сетевой вызов и возвращает результат.
// Узкий контракт: плагин шлёт и получает готовый JSON (OpenAI-compatible LLM).
interface http {
  // Выполнить POST с JSON-телом. Возвращает HTTP-статус и тело ответа (как строку).
  post-json: async func(url: string, json-body: string) -> tuple<u16, string>;
}

interface plugin-lifecycle {
  use types.{event};

  init: async func(config-json: string) -> list<string>;
  run: async func(); // Если нужен параллельный цикл обработки для плагина.
  handle-event: async func(ev: event);
}

world host-plugin {
  import event-bus;
  import console;
  import log;
  import http;
  export plugin-lifecycle;
}
