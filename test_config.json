{
  "plugins": [
    {
      "file": "./target/wasm32-wasip2/debug/front_console_plugin.wasm",
      "name": "console",
      "class": "front",
      "access": ["console"],
      "config": {
        "subscriptions": ["system:info", "system:error"],
        "targets": ["system:info"]
      },
      "allow_background": true
    }
  ],
  "metrics": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 9090,
    "update_interval_secs": 15,
    "location": "/metrics"
  }
}
